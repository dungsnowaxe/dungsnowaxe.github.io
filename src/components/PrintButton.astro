---
import * as stylex from '@stylexjs/stylex';
import { printButton as styles } from '../styles/print-button.stylex';
import { hoverAncestor } from '../styles/markers.stylex';
import { cx } from '../styles/cx';

export interface Props {
  lang?: 'en' | 'vi';
}

const { lang = 'en' } = Astro.props;
const label = lang === 'vi' ? 'Lưu PDF' : 'Save PDF';
const buttonClass = cx('print-button', stylex.attrs(styles.button, hoverAncestor).class);
---

<button class={buttonClass} onclick="window.print()" aria-label={lang === 'vi' ? 'Tải CV dạng PDF' : 'Download resume as PDF'}>
  <span>{label}</span>
  <span {...stylex.attrs(styles.icon)} aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12"></path>
      <path d="m7 10 5 5 5-5"></path>
      <path d="M5 21h14"></path>
    </svg>
  </span>
</button>
