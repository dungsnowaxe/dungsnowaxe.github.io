---
import * as stylex from '@stylexjs/stylex';
import { themeToggle as styles } from '../styles/theme-toggle.stylex';
import { cx } from '../styles/cx';

export interface Props {
  lang?: 'en' | 'vi';
}

const { lang = 'en' } = Astro.props;

const labels = lang === 'vi'
  ? { light: 'Giao diện sáng', dark: 'Giao diện tối', auto: 'Theo hệ thống' }
  : { light: 'Light theme', dark: 'Dark theme', auto: 'System theme' };

const controlClass = cx('theme-control', stylex.attrs(styles.control).class);
const modeClass = stylex.attrs(styles.mode).class;
---

<div class={controlClass} role="group" aria-label="Theme">
  <button type="button" class={cx('mode', 'mode-light', modeClass)} onclick="setThemeMode('light')" aria-label={labels.light} title={labels.light}>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2"/><path d="M12 20v2"/>
      <path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
      <path d="M2 12h2"/><path d="M20 12h2"/>
      <path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
    </svg>
  </button>
  <button type="button" class={cx('mode', 'mode-dark', modeClass)} onclick="setThemeMode('dark')" aria-label={labels.dark} title={labels.dark}>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
    </svg>
  </button>
  <button type="button" class={cx('mode', 'mode-auto', modeClass)} onclick="setThemeMode('auto')" aria-label={labels.auto} title={labels.auto}>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="13" rx="2"/>
      <path d="M8 21h8"/><path d="M12 17v4"/>
    </svg>
  </button>
</div>

<style is:global>
  [data-theme-mode="light"] .theme-control .mode-light,
  [data-theme-mode="dark"] .theme-control .mode-dark,
  [data-theme-mode="auto"] .theme-control .mode-auto {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
