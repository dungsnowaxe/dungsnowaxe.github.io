---
import * as stylex from '@stylexjs/stylex';
import { skills as styles } from '../styles/skills.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    skills: Record<string, string[]>;
  };
  heading?: string;
}

const { data, heading = "Skills" } = Astro.props;

const iconMap: Record<string, string[]> = {
  "TypeScript": ["typescript"],
  "JavaScript (ES6+)": ["javascript"],
  "HTML5": ["html5"],
  "CSS3 / SCSS": ["css"],
  "React": ["react"],
  "Vue": ["vuedotjs"],
  "Astro": ["astro"],
  "Next.js": ["nextdotjs"],
  "Tailwind CSS": ["tailwindcss"],
  "GSAP": ["greensock"],
  "Electron": ["electron"],
  "React Native": ["react"],
  "Git & GitHub": ["git"],
  "Figma": ["figma"],
  "CI/CD": ["githubactions"],
  "Webpack / Vite": ["webpack", "vite"],
  "Docker": ["docker"],
};
---

<div class={cx('rail-section', 'reveal')}>
  <span class="section-label">{heading}</span>
  <div {...stylex.attrs(styles.list)}>
    {Object.entries(data.skills).map(([category, items]) => (
      <div>
        <h4>{category}</h4>
        <div {...stylex.attrs(styles.tags)}>
          {items.map((skill) => {
            const slugs = iconMap[skill] || [];
            const iconAttrs = stylex.attrs(styles.tagIcon);
            return (
              <span class={cx('tag', stylex.attrs(styles.tag).class)}>
                {slugs.map((slug) => (
                  <span
                    class={iconAttrs.class}
                    aria-hidden="true"
                    style={`-webkit-mask-image: url('https://cdn.simpleicons.org/${slug}'); mask-image: url('https://cdn.simpleicons.org/${slug}'); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: center; mask-position: center; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;`}
                  ></span>
                ))}
                {skill}
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>
