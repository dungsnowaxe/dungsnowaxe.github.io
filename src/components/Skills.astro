---
import * as stylex from '@stylexjs/stylex';
import { skills as styles } from '../styles/skills.stylex';
import { brandPaths } from '../data/brand-icons';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    skills: Record<string, string[]>;
  };
  heading?: string;
}

const { data, heading = "Skills" } = Astro.props;

const iconMap: Record<string, string[]> = {
  "TypeScript": ["typescript"],
  "JavaScript (ES6+)": ["javascript"],
  "HTML5": ["html5"],
  "CSS3 / SCSS": ["css"],
  "React": ["react"],
  "Vue": ["vuedotjs"],
  "Astro": ["astro"],
  "Next.js": ["nextdotjs"],
  "Tailwind CSS": ["tailwindcss"],
  "GSAP": ["greensock"],
  "Electron": ["electron"],
  "React Native": ["react"],
  "Git & GitHub": ["git"],
  "Figma": ["figma"],
  "CI/CD": ["githubactions"],
  "Webpack / Vite": ["webpack", "vite"],
  "Docker": ["docker"],
};
---

<div class={cx('rail-section')}>
  <h2 class="section-label">{heading}</h2>
  <div {...stylex.attrs(styles.list)}>
    {Object.entries(data.skills).map(([category, items]) => (
      <div>
        <h3 class="skill-group-title">{category}</h3>
        <div {...stylex.attrs(styles.tags)}>
          {items.map((skill) => {
            const slugs = (iconMap[skill] || []).filter((slug) => brandPaths[slug]);
            const iconAttrs = stylex.attrs(styles.tagIcon);
            return (
              <span class={cx('tag', stylex.attrs(styles.tag).class)}>
                {slugs.map((slug) => (
                  <svg class={iconAttrs.class} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={brandPaths[slug]} />
                  </svg>
                ))}
                {skill}
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>
