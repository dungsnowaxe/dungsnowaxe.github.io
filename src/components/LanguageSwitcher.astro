---
import * as stylex from '@stylexjs/stylex';
import { languageSwitcher as styles } from '../styles/language-switcher.stylex';

export interface Props {
  currentLang?: 'en' | 'vi';
  page?: 'home' | 'resume';
}

const { currentLang = 'en', page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL || '/';

const routes = {
  home: { en: base === '/' ? '/' : `${base}/`, vi: base === '/' ? '/vi/' : `${base}/vi/` },
  resume: { en: base === '/' ? '/resume/' : `${base}/resume/`, vi: base === '/' ? '/vi/resume/' : `${base}/vi/resume/` }
};

const enUrl = routes[page].en;
const viUrl = routes[page].vi;
---

<div {...stylex.attrs(styles.switcher)}>
  <a href={enUrl} {...stylex.attrs(styles.link, currentLang === 'en' && styles.active)} aria-label="English" aria-current={currentLang === 'en' ? 'page' : undefined}>EN</a>
  <span {...stylex.attrs(styles.divider)} aria-hidden="true"></span>
  <a href={viUrl} {...stylex.attrs(styles.link, currentLang === 'vi' && styles.active)} aria-label="Tiếng Việt" aria-current={currentLang === 'vi' ? 'page' : undefined}>VI</a>
</div>
