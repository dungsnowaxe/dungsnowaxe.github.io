---
export interface Props {
  currentLang?: 'en' | 'vi';
  page?: 'home' | 'resume';
}

const { currentLang = 'en', page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL || '/';

const routes = {
  home: { en: base === '/' ? '/' : `${base}/`, vi: base === '/' ? '/vi/' : `${base}/vi/` },
  resume: { en: base === '/' ? '/resume/' : `${base}/resume/`, vi: base === '/' ? '/vi/resume/' : `${base}/vi/resume/` }
};

const enUrl = routes[page].en;
const viUrl = routes[page].vi;
---

<div class="lang-switcher">
  <a href={enUrl} class={currentLang === 'en' ? 'active' : ''} aria-label="English">EN</a>
  <span class="divider">/</span>
  <a href={viUrl} class={currentLang === 'vi' ? 'active' : ''} aria-label="Tiếng Việt">VI</a>
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .lang-switcher a {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
    /* Enforce a ≥44px touch target while keeping the label visually compact */
    padding: 0.6rem 0.3rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .lang-switcher a:hover {
    color: var(--text);
  }

  .lang-switcher a.active {
    color: var(--accent);
    font-weight: 600;
  }

  .divider {
    color: var(--text-tertiary);
    opacity: 0.4;
  }

  @media print {
    .lang-switcher {
      display: none !important;
    }
  }
</style>
