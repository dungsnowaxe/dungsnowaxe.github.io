---
import * as stylex from '@stylexjs/stylex';
import { experience as styles } from '../styles/experience.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    experience: Array<{
      impact: string;
      title: string;
      company: string;
      period: string;
      details: string[];
    }>;
  };
  heading?: string;
}

const { data, heading = "Experience" } = Astro.props;
---

<section class={cx('experience-section', 'reveal')}>
  <h2>{heading}</h2>
  <div {...stylex.attrs(styles.list)}>
    {data.experience.map((job, index) => (
      <article class={cx('experience-entry', stylex.attrs(styles.entry).class)}>
        <span {...stylex.attrs(styles.index)} aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div {...stylex.attrs(styles.body)}>
          <div {...stylex.attrs(styles.header)}>
            <div {...stylex.attrs(styles.titleGroup)}>
              <h3>{job.impact}</h3>
              <div {...stylex.attrs(styles.meta)}>
                <span {...stylex.attrs(styles.jobTitle)}>{job.title}</span>
                <span {...stylex.attrs(styles.company)}>{job.company}</span>
              </div>
            </div>
            <span {...stylex.attrs(styles.dateBadge)}>{job.period}</span>
          </div>
          <ul class={cx('experience-details', stylex.attrs(styles.details).class)}>
            {job.details.map((detail) => (
              <li {...stylex.attrs(styles.detail)}>{detail}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
