---
import * as stylex from '@stylexjs/stylex';
import { about as styles } from '../styles/about.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    aboutMe: string;
  };
  heading?: string;
}

const { data, heading = "About" } = Astro.props;
---

<div class={cx('rail-section', 'reveal')}>
  <span class="section-label">{heading}</span>
  <p {...stylex.attrs(styles.aboutText)}>{data.aboutMe}</p>
</div>
