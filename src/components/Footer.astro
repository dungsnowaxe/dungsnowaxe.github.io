---
export interface Props {
  data: {
    footer: {
      line1: string;
      line2: string;
    };
  };
}

const { data } = Astro.props;
---

<footer class="footer reveal">
  <p class="footer-text">{data.footer.line1}</p>
  <p class="footer-sub">{data.footer.line2}</p>
</footer>

<style>
  .footer {
    padding: var(--space-8) 0 var(--space-4);
    text-align: center;
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-1);
  }

  .footer-sub {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-style: italic;
  }
</style>
