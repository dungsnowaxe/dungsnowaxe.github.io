---
import * as stylex from '@stylexjs/stylex';
import { footer as styles } from '../styles/footer.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    footer: {
      line1: string;
      line2: string;
    };
  };
}

const { data } = Astro.props;
---

<footer class={cx('reveal', stylex.attrs(styles.footer).class)}>
  {data.footer.line1 && <p {...stylex.attrs(styles.text)}>{data.footer.line1}</p>}
  {data.footer.line2 && <p {...stylex.attrs(styles.sub)}>{data.footer.line2}</p>}
</footer>
