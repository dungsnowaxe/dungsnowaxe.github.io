---
export interface Props {
  data: {
    education: Array<{
      degree: string;
      institution: string;
      period: string;
      description: string;
    }>;
  };
  heading?: string;
}

const { data, heading = "Education" } = Astro.props;
---

<div class="rail-section">
  <span class="section-label">{heading}</span>
  <div class="education-list">
    {data.education.map((edu) => (
      <div class="education-entry">
        <h3 class="education-degree">{edu.degree}</h3>
        <span class="education-school">{edu.institution}</span>
        <span class="education-period">{edu.period}</span>
        <p class="education-desc">{edu.description}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .education-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .education-degree {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.1rem;
  }

  .education-school {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-secondary);
    display: block;
    margin-bottom: 0.15rem;
  }

  .education-period {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    display: block;
    margin-bottom: var(--space-2);
  }

  .education-desc {
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-tertiary);
  }
</style>
