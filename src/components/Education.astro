---
import * as stylex from '@stylexjs/stylex';
import { education as styles } from '../styles/education.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    education: Array<{
      degree: string;
      institution: string;
      period: string;
      description: string;
    }>;
  };
  heading?: string;
}

const { data, heading = "Education" } = Astro.props;
---

<div class={cx('rail-section', 'reveal')}>
  <h2 class="section-label">{heading}</h2>
  <div {...stylex.attrs(styles.list)}>
    {data.education.map((edu) => (
      <div>
        <h3 {...stylex.attrs(styles.degree)}>{edu.degree}</h3>
        <span {...stylex.attrs(styles.school)}>{edu.institution}</span>
        <span {...stylex.attrs(styles.period)}>{edu.period}</span>
        <p {...stylex.attrs(styles.desc)}>{edu.description}</p>
      </div>
    ))}
  </div>
</div>
