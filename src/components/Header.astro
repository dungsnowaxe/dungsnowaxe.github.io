---
import * as stylex from '@stylexjs/stylex';
import { header as styles } from '../styles/header.stylex';
import { hoverAncestor } from '../styles/markers.stylex';
import { cx } from '../styles/cx';

export interface Props {
  data: {
    personalInfo: {
      fullName: string;
      jobTitle: string;
      phone: string;
      email: string;
    };
  };
  labels?: {
    phone?: string;
    email?: string;
  };
}

const { data, labels = {} } = Astro.props;
const { personalInfo } = data;
const labelPhone = labels.phone || "Phone";
const labelEmail = labels.email || "Email";
---

<div class={cx('reveal', stylex.attrs(styles.header).class)}>
  <div {...stylex.attrs(styles.nameBlock)}>
    <h1>{personalInfo.fullName}</h1>
    <p {...stylex.attrs(styles.jobTitle)}>{personalInfo.jobTitle}</p>
  </div>
  <div {...stylex.attrs(styles.contactList)}>
    <a {...stylex.attrs(styles.contactItem, hoverAncestor)} href={`mailto:${personalInfo.email}`}>
      <svg {...stylex.attrs(styles.contactSvg)} xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      <span {...stylex.attrs(styles.contactText)}>
        <span {...stylex.attrs(styles.contactLabel)}>{labelEmail}</span>
        <span {...stylex.attrs(styles.contactValue)}>{personalInfo.email}</span>
      </span>
    </a>
    <a {...stylex.attrs(styles.contactItem, hoverAncestor)} href={`tel:${personalInfo.phone.replace(/[^+\d]/g, '')}`}>
      <svg {...stylex.attrs(styles.contactSvg)} xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span {...stylex.attrs(styles.contactText)}>
        <span {...stylex.attrs(styles.contactLabel)}>{labelPhone}</span>
        <span {...stylex.attrs(styles.contactValue)}>{personalInfo.phone}</span>
      </span>
    </a>
  </div>
</div>
