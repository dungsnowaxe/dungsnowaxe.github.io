---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import portrait from '../assets/portrait.jpg';
import cvData from '../data/cv.json';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;
const base = import.meta.env.BASE_URL || '/';
const resumeUrl = base === '/' ? '/resume/' : `${base}/resume/`;
---

<Layout title={title} description={`Personal homepage of ${personalInfo.fullName}`} lang="en">
  <div class="top-controls">
    <LanguageSwitcher currentLang="en" page="home" />
    <ThemeToggle />
  </div>

  <main id="main" class="hero">
    <div class="hero-portrait">
      <Picture src={portrait} alt={`${personalInfo.fullName}, Senior Frontend Developer`} widths={[480, 960, 1280, 1920]} sizes="50vw" loading="eager" fetchpriority="high" formats={['avif', 'webp']} />
    </div>
    <div class="hero-content">
      <span class="hero-label">{personalInfo.jobTitle}</span>
      <h1 class="hero-name">{personalInfo.fullName}</h1>
      <div class="hero-links">
        <a href={resumeUrl} class="hero-link primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          View Resume
        </a>
        <a href="https://github.com/dungsnowaxe" class="hero-link" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://linkedin.com/in/dungsnowaxe" class="hero-link" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href={`mailto:${personalInfo.email}`} class="hero-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Email
        </a>
      </div>
    </div>
</main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .hero-portrait {
    position: relative;
    overflow: hidden;
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    object-position: center 20%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-8) var(--space-7);
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }

  .hero-name {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: var(--space-7);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    background: transparent;
    text-decoration: none;
    transition: all 0.25s var(--ease-out);
  }

  .hero-link:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-1px);
    opacity: 1;
  }

  .hero-link:active {
    transform: translateY(0) scale(0.98);
  }

  .hero-link.primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 500;
  }

  .hero-link.primary:hover {
    box-shadow: 0 4px 16px color-mix(in oklch, var(--accent) 30%, transparent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .hero-link svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-portrait :global(img) {
      height: 50vh;
      height: 50dvh;
    }

    .hero-content {
      padding: var(--space-6) var(--space-4);
      padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
    }

    .hero-name {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .hero-links {
      gap: var(--space-3);
    }

    .hero-link {
      flex: 1 1 auto;
      justify-content: center;
      padding: 0.75rem 1rem;
      min-height: 44px;
    }
  }
</style>
