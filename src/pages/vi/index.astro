---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import portrait from '../../assets/portrait.jpg';
import cvData from '../../data/cv-vi.json';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;
const base = import.meta.env.BASE_URL || '/';
const resumeUrl = base === '/' ? '/vi/resume/' : `${base}/vi/resume/`;
---

<Layout title={title} description={`Trang cá nhân của ${personalInfo.fullName}`} lang="vi">
  <div class="top-controls">
    <LanguageSwitcher currentLang="vi" page="home" />
    <ThemeToggle lang="vi" />
  </div>

  <main id="main" class="hero">
    <div class="hero-portrait">
      <Picture src={portrait} alt={`${personalInfo.fullName}, ${personalInfo.jobTitle}`} widths={[480, 960, 1280, 1920]} sizes="50vw" loading="eager" fetchpriority="high" formats={['avif', 'webp']} />
    </div>
    <div class="hero-content">
      <span class="hero-eyebrow">{personalInfo.jobTitle}</span>
      <h1 class="hero-name">{personalInfo.fullName}</h1>
      <div class="hero-links">
        <a href={resumeUrl} class="hero-link primary">
          <span>Xem CV</span>
          <span class="link-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
          </span>
        </a>
        <a href="https://github.com/dungsnowaxe" class="hero-link" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://linkedin.com/in/dungsnowaxe" class="hero-link" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href={`mailto:${personalInfo.email}`} class="hero-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          Email
        </a>
      </div>
    </div>
</main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .hero-portrait {
    position: relative;
    overflow: hidden;
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    object-position: center 20%;
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-9) var(--space-8);
  }

  .hero-content::before {
    content: '';
    position: absolute;
    top: 12%;
    right: -10%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--accent);
    margin-bottom: var(--space-5);
  }

  .hero-eyebrow::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: var(--accent);
  }

  .hero-name {
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 480;
    font-variation-settings: 'opsz' 144;
    letter-spacing: 0;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: var(--space-8);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    background: transparent;
    text-decoration: none;
    transition: color 0.3s var(--ease-spring),
                border-color 0.3s var(--ease-spring),
                background-color 0.3s var(--ease-spring),
                transform 0.3s var(--ease-spring),
                box-shadow 0.3s var(--ease-spring);
  }

  .hero-link:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface);
    transform: translateY(-2px);
    opacity: 1;
  }

  .hero-link:active {
    transform: translateY(0) scale(0.98);
  }

  .hero-link.primary {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
    font-weight: 500;
    padding: 0.45rem 0.45rem 0.45rem 1.25rem;
    gap: var(--space-3);
    box-shadow: var(--shadow-ambient);
  }

  .hero-link.primary .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--on-accent) 18%, transparent);
    transition: transform 0.35s var(--ease-spring);
  }

  .hero-link.primary:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
    border-color: transparent;
    box-shadow: var(--shadow-lifted);
  }

  .hero-link.primary:hover .link-icon {
    transform: translate(2px, -2px) scale(1.05);
  }

  .hero-link svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-portrait :global(img) {
      height: 52vh;
      height: 52dvh;
    }

    .hero-content {
      padding: var(--space-7) var(--space-4);
      padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom));
    }

    .hero-name {
      font-size: clamp(2.25rem, 9vw, 3.25rem);
      margin-bottom: var(--space-6);
    }

    .hero-link {
      flex: 1 1 auto;
      justify-content: center;
      min-height: 44px;
    }

    .hero-link.primary {
      flex: 1 1 100%;
      justify-content: space-between;
    }
  }
</style>
