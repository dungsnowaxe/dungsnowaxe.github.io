---
import * as stylex from '@stylexjs/stylex';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import portrait from '../../assets/portrait.jpg';
import cvData from '../../data/cv-vi.json';
import { hero } from '../../styles/hero.stylex';
import { hoverAncestor } from '../../styles/markers.stylex';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;
const base = import.meta.env.BASE_URL || '/';
const resumeUrl = base === '/' ? '/vi/resume/' : `${base}/vi/resume/`;
---

<Layout title={title} description="Kỹ sư frontend. React, Next.js, Vue. Fintech, bảo mật và SaaS." lang="vi" canonicalUrl="https://dungsnowaxe.github.io/vi/">
  <div class="hero-page">
    <div class="top-controls">
      <LanguageSwitcher currentLang="vi" page="home" />
      <ThemeToggle lang="vi" />
    </div>

    <main id="main" {...stylex.attrs(hero.root)}>
      <div {...stylex.attrs(hero.portrait)}>
        <Picture src={portrait} alt={`${personalInfo.fullName}, ${personalInfo.jobTitle}`} widths={[480, 960, 1280, 1920]} sizes="(max-width: 768px) 100vw, 50vw" loading="eager" fetchpriority="high" formats={['avif', 'webp']} class={stylex.attrs(hero.portraitImg).class} pictureAttributes={stylex.attrs(hero.portraitPicture)} />
      </div>
      <div {...stylex.attrs(hero.content)}>
        <span {...stylex.attrs(hero.eyebrow)}>{personalInfo.jobTitle}</span>
        <h1 {...stylex.attrs(hero.name)}>{personalInfo.fullName}</h1>
        <div {...stylex.attrs(hero.links)}>
          <a href={resumeUrl} {...stylex.attrs(hero.link, hero.linkPrimary, hoverAncestor)}>
            <span>Xem CV</span>
            <span {...stylex.attrs(hero.linkIcon)} aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
            </span>
          </a>
          <a href="https://github.com/dungsnowaxe" {...stylex.attrs(hero.link)} target="_blank" rel="noopener noreferrer">
            <svg {...stylex.attrs(hero.linkSvg)} xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            GitHub
          </a>
          <a href="https://linkedin.com/in/dungsnowaxe" {...stylex.attrs(hero.link)} target="_blank" rel="noopener noreferrer">
            <svg {...stylex.attrs(hero.linkSvg)} xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a href={`mailto:${personalInfo.email}`} {...stylex.attrs(hero.link)}>
            <svg {...stylex.attrs(hero.linkSvg)} xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            Email
          </a>
        </div>
      </div>
    </main>
  </div>
</Layout>
