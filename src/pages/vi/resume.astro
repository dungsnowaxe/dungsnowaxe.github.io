---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import About from '../../components/About.astro';
import Experience from '../../components/Experience.astro';
import Education from '../../components/Education.astro';
import Skills from '../../components/Skills.astro';
import Footer from '../../components/Footer.astro';
import PrintButton from '../../components/PrintButton.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import cvData from '../../data/cv-vi.json';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;

const headerLabels = {
  dateOfBirth: "Ngày sinh",
  phone: "Điện thoại",
  email: "Email",
  address: "Địa chỉ"
};
---

<Layout title={title} description={`CV cá nhân của ${personalInfo.fullName}`} lang="vi">
  <div class="top-controls">
    <LanguageSwitcher currentLang="vi" page="resume" />
    <ThemeToggle />
  </div>
  <div class="cv-grid">
    <aside class="left-rail">
      <Header data={cvData} labels={headerLabels} />
      <About data={cvData} heading="Giới thiệu" />
      <Skills data={cvData} heading="Kỹ năng chuyên môn" />
      <Education data={cvData} heading="Học vấn" />
    </aside>
    <main class="main-content">
      <Experience data={cvData} heading="Kinh nghiệm" />
      <Footer data={cvData} />
    </main>
  </div>
  <PrintButton />
</Layout>
