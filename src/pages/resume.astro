---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';
import PrintButton from '../components/PrintButton.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import cvData from '../data/cv.json';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;
---

<Layout title={title} description={`Personal CV of ${personalInfo.fullName}`} lang="en">
  <div class="top-controls">
    <LanguageSwitcher currentLang="en" page="resume" />
    <ThemeToggle />
  </div>
  <div class="cv-grid">
    <aside class="left-rail">
      <Header data={cvData} />
      <About data={cvData} heading="About" />
      <Skills data={cvData} heading="Skills" />
      <Education data={cvData} heading="Education" />
    </aside>
    <main id="main" class="main-content">
      <Experience data={cvData} heading="Experience" />
      <Footer data={cvData} />
    </main>
  </div>
  <PrintButton />
</Layout>
