---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';
import PrintButton from '../components/PrintButton.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import cvData from '../data/cv-vi.json';

const { personalInfo } = cvData;
const title = `${personalInfo.fullName} — ${personalInfo.jobTitle}`;

const heroLabels = {
  greeting: "Xin chào, tôi là",
  dateOfBirth: "Ngày sinh",
  phone: "Điện thoại",
  email: "Email",
  address: "Địa chỉ"
};
---

<Layout title={title} description={`CV cá nhân của ${personalInfo.fullName}`} lang="vi">
  <LanguageSwitcher currentLang="vi" />
  <main>
    <Hero data={cvData} labels={heroLabels} />
    <About data={cvData} heading="Giới thiệu" />
    <Experience data={cvData} heading="Kinh nghiệm" />
    <Education data={cvData} heading="Học vấn" />
    <Skills data={cvData} heading="Kỹ năng chuyên môn" />
    <Footer data={cvData} />
  </main>
  <PrintButton />
</Layout>

<style>
  main {
    position: relative;
  }
</style>
