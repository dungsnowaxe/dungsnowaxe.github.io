---
import '../styles/global.css';
import '../styles/print.css';
import '../styles/tokens.stylex';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title = "Personal CV", description = "Personal CV", lang = "en" } = Astro.props;
const siteUrl = 'https://dungsnowaxe.github.io';
const ogImage = `${siteUrl}/ABMM0487ds.jpg`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <meta name="theme-color" content="#f7f2ea" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#211a13" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={siteUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Manrope:wght@400..800&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    (function() {
      var mode = localStorage.getItem('theme') || 'auto';
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var resolved = mode === 'auto' ? (mq.matches ? 'dark' : 'light') : mode;
      var html = document.documentElement;
      html.setAttribute('data-theme-mode', mode);
      html.setAttribute('data-theme', resolved);
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />

  <script is:inline>
    (function() {
      var html = document.documentElement;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');

      function resolveMode(mode) {
        return mode === 'auto' ? (mq.matches ? 'dark' : 'light') : mode;
      }

      window.setThemeMode = function(mode) {
        html.classList.add('theme-transition');
        html.setAttribute('data-theme-mode', mode);
        html.setAttribute('data-theme', resolveMode(mode));
        localStorage.setItem('theme', mode);
        setTimeout(function() { html.classList.remove('theme-transition'); }, 500);
      };

      // Follow the OS while in auto mode
      mq.addEventListener('change', function() {
        if (html.getAttribute('data-theme-mode') === 'auto') {
          html.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
        }
      });

      // Staggered scroll-entry reveals (transform/opacity/filter only)
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      var staggerIndex = 0;
      document.querySelectorAll('.reveal').forEach(function(el) {
        el.style.transitionDelay = Math.min(staggerIndex * 70, 350) + 'ms';
        staggerIndex++;
        observer.observe(el);
      });
    })();
  </script>
</body>
</html>
